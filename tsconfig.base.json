{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@foldthink/surface": ["./domains/surface/src/public.ts"],
      "@foldthink/workspace": ["./domains/workspace/src/public.ts"],
      "@foldthink/interaction/browser": ["./domains/interaction/src/public-browser.ts"],
      "@foldthink/local-persistence/browser": ["./domains/local-persistence/src/public-browser.ts"],
      "@foldthink/agent-integration/browser": ["./domains/agent-integration/src/public-browser.ts"]
    }
  }
}
