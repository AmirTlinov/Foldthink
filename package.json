{
  "name": "foldthink",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @foldthink/web dev",
    "build": "pnpm --filter @foldthink/web build",
    "lint": "eslint .",
    "verify:map": "node scripts/verify-project-map.mjs",
    "verify:contracts": "node scripts/verify-contract-links.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:packages": "pnpm --recursive --if-present --filter '!foldthink' run typecheck && pnpm --recursive --if-present --filter '!foldthink' run test",
    "verify:journeys": "playwright test",
    "verify": "pnpm verify:map && pnpm verify:contracts && pnpm verify:boundaries && pnpm lint && pnpm verify:packages && pnpm verify:journeys",
    "test": "pnpm verify"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.13"
  }
}
