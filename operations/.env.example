FOLDTHINK_REVISION=replace-with-the-exact-git-commit
FOLDTHINK_IMAGE=ghcr.io/amirtlinov/foldthink@sha256:replace-with-image-digest
FOLDTHINK_POSTGRES_IMAGE=ghcr.io/amirtlinov/foldthink-postgres@sha256:replace-with-image-digest
FOLDTHINK_PUBLIC_ORIGIN=https://foldthink.example
FOLDTHINK_SITE_ADDRESS=https://foldthink.example

POSTGRES_PASSWORD=replace-with-a-random-password
SESSION_HMAC_KEY=replace-with-at-least-32-random-bytes
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=21600

ASSET_S3_BUCKET=foldthink-assets
ASSET_S3_REGION=auto
ASSET_S3_ENDPOINT=https://replace-with-object-storage-endpoint
ASSET_S3_FORCE_PATH_STYLE=false
ASSET_S3_ACCESS_KEY_ID=replace-me
ASSET_S3_SECRET_ACCESS_KEY=replace-me

PGBACKREST_S3_BUCKET=foldthink-backups
PGBACKREST_S3_REGION=auto
PGBACKREST_S3_ENDPOINT=replace-with-s3-host-without-a-scheme
PGBACKREST_STORAGE_PORT=443
PGBACKREST_S3_KEY=replace-me
PGBACKREST_S3_KEY_SECRET=replace-me
PGBACKREST_S3_URI_STYLE=host
PGBACKREST_STORAGE_VERIFY_TLS=y
PGBACKREST_CIPHER_PASS=replace-with-a-long-independent-secret
PGBACKREST_RETENTION_FULL=4
