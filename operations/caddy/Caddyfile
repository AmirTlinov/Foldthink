{
  admin off
  http_port 8080
  https_port 8443
}

{$FOLDTHINK_SITE_ADDRESS} {
  encode zstd gzip

  @internal path /internal/*
  handle @internal {
    respond 404
  }

  @application path /api/* /sync /health /ready
  handle @application {
    reverse_proxy app:8787
  }

  handle {
    root * /opt/foldthink/web
    try_files {path} /index.html
    file_server
  }

  @widgetFrame path /widget-frame.html
  header @widgetFrame {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; media-src data: blob:; font-src data:; connect-src 'none'; frame-src 'none'"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), tools=()"
    -Server
  }

  @browserModules path /assets/*.js
  header @browserModules Access-Control-Allow-Origin "*"

  @applicationShell {
    not path /widget-frame.html
  }
  header @applicationShell {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; worker-src 'self' blob:; frame-src 'self'"
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), tools=(self)"
    -Server
  }
}
